---
// One of Fernleigh's products as the bank itself would ship it. Used two ways:
// on /play it's the live chat (with `live`), on the home page a still sample of the same product.
import '../styles/bank.css';
import { bank } from '../data/bank';
import { MAX_MESSAGE_LENGTH } from '../engine/budget';
import { TOOL_INFO } from '../engine/tools';

type Msg = { who: 'bot' | 'you' | 'system'; text: string };
type Props = {
  title: string;
  subtitle: string;
  greeting: string;
  sample?: Msg[];
  live?: boolean;
  label: string;
  /** Agent levels: the signed-in customer, shown with the panel that logs every tool the agent calls. */
  agent?: { name: string; id: string };
};
const { title, subtitle, greeting, sample = [], live = false, label, agent } = Astro.props;
---
<div data-ui="bank" class:list={['bank-chat', { 'bank-chat--live': live, 'bank-chat--agent': agent }]} role={live ? undefined : 'img'} aria-label={live ? undefined : label}>
  <div class="bank-head">
    <span class="bank-logo" aria-hidden="true">{bank.name[0]}</span>
    <div>
      <div class="bank-title">{title}</div>
      <div class="bank-sub">{subtitle}</div>
    </div>
    {live && <button type="button" class="bank-new" data-new-chat>New chat</button>}
  </div>
  {agent && (
    <section class="bank-tools" aria-labelledby="bank-tools-title">
      <div class="bank-tools-head">
        <h2 class="bank-tools-title" id="bank-tools-title">Agent actions</h2>
        <p class="bank-tools-who">Signed in: {agent.name} · {agent.id}</p>
      </div>
      <ol class="bank-tools-list" data-tool-log aria-live="polite">
        <li class="bank-tools-empty" data-tool-empty>No actions yet. When the agent looks up an account or issues a refund, it shows here.</li>
      </ol>
      <div class="bank-tools-avail">
        <h3 class="bank-tools-sub">Tools it can use</h3>
        <dl>
          {TOOL_INFO.map((t) => (
            <div>
              <dt><code>{t.call}</code></dt>
              <dd>{t.does}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}
  <ol class="bank-log" data-log aria-live={live ? 'polite' : undefined} aria-label={live ? 'Conversation' : undefined}>
    <li class="bank-msg bank-msg--bot">{greeting}</li>
    {sample.map((m) => (
      <li class={`bank-msg bank-msg--${m.who}`}>{m.text}</li>
    ))}
  </ol>
  {live ? (
    <form class="bank-form" data-form>
      <label for="message" class="visually-hidden">Message {title}</label>
      <textarea id="message" name="message" rows="1" maxlength={MAX_MESSAGE_LENGTH} placeholder="Type a message" required></textarea>
      <button class="bank-send" type="submit">Send</button>
    </form>
  ) : (
    <div class="bank-form" aria-hidden="true">
      <div class="bank-fake-input">Type a message</div>
      <span class="bank-send bank-send--still">Send</span>
    </div>
  )}
</div>

<style>
  .bank-chat {
    height: 100%;
  }
  .bank-fake-input {
    flex: 1;
    height: 44px;
    padding: 11px 12px;
    border: 1px solid var(--b-border); /* taste-skill-ignore: the bank's own input, inside data-ui */
    border-radius: var(--b-radius-control);
    background: var(--b-ground);
    color: var(--b-muted);
  }
  .bank-send--still {
    display: grid;
    place-items: center;
  }
</style>
