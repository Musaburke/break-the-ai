---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import { bank } from '../../data/bank';
import type { ReportSummary } from '../../engine/report';

// Public: anyone with the link can read it. It holds only game data, never anything the player typed.
export const prerender = false;

const id = Astro.params.id ?? '';
const row = /^[A-Za-z0-9_-]{12}$/.test(id)
  ? await env.DB.prepare('SELECT summary_json FROM reports WHERE id = ?').bind(id).first<{ summary_json: string }>()
  : null;
if (!row) Astro.response.status = 404;
const report = row ? (JSON.parse(row.summary_json) as ReportSummary) : null;
// Reports made before scoring existed have no score: show what they do have.
const score = report?.score ?? null;
const fmt = (n: number) => n.toLocaleString('en-GB');
const date = report ? new Date(`${report.date}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
---
<Base
  title={report ? `Pentest report: ${bank.name} · Break the AI` : 'Report not found · Break the AI'}
  description={report ? `${report.findings.length} of ${bank.name}'s AI products broken${score !== null ? ` for ${fmt(score)} points` : ''}.` : undefined}
>
  {report ? (
    <>
      <section class="cover" aria-labelledby="report-title">
        <div class="wrap">
          <p class="label cover-label">Pentest report · {bank.name} · {date}</p>
          <h1 id="report-title">{score !== null ? `${fmt(score)} pts` : 'Broken'}</h1>
          <dl class="totals">
            <div><dt class="label">Products broken</dt><dd>{report.findings.length}</dd></div>
            <div><dt class="label">Messages</dt><dd>{report.totalMessages}</dd></div>
            <div><dt class="label">Hints</dt><dd>{report.totalHints}</dd></div>
            {report.easy && <div><dt class="label">Difficulty</dt><dd>Easy</dd></div>}
          </dl>
        </div>
      </section>

      <section class="findings wrap" aria-labelledby="findings-title">
        <h2 id="findings-title">Findings</h2>
        <ol class="finding-list">
          {report.findings.map((f) => (
            <li class="finding">
              <p class="finding-name">{f.product}</p>
              <p class="finding-owasp">{f.owasp.join(' · ')}</p>
              <p class="finding-cost">{f.points !== undefined ? `${fmt(f.points)} pts` : `${f.messages} messages, ${f.hints} hints`}</p>
            </li>
          ))}
        </ol>
        <p class="note">Every finding: broken. The fix, every time: keep secrets out of the prompt.</p>
        <a class="pill pill--big" href="/">Beat this score</a>
      </section>
    </>
  ) : (
    <section class="missing wrap" aria-labelledby="missing-title">
      <h1 id="missing-title">No report here</h1>
      <p>The link may be mistyped. Reports are made by clearing the game.</p>
      <a class="pill pill--big" href="/">Play</a>
    </section>
  )}
</Base>

<style>
  .cover {
    margin: 0 var(--margin);
    border-radius: var(--radius);
    background: var(--accent);
    color: var(--accent-ink);
    padding-block: clamp(32px, 7vh, 80px) clamp(24px, 4vh, 40px);
  }

  .cover .label {
    color: var(--accent-ink);
  }

  .cover h1 {
    margin-top: 20px;
    font-size: var(--step-hero);
    line-height: 0.86;
  }

  .totals {
    margin: clamp(32px, 6vh, 64px) 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .totals div {
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--accent-ink);
    color: var(--ink);
  }

  .totals .label {
    color: var(--muted);
  }

  .totals dd {
    margin: 8px 0 0;
    font: 800 var(--step-head) / 0.9 var(--display);
    font-variant-numeric: tabular-nums;
  }

  .findings {
    padding-block: 64px 48px;
  }

  .finding-list {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .finding {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 4fr) minmax(0, 2fr);
    gap: 16px;
    align-items: baseline;
    padding: 20px 24px;
    border-radius: 12px;
    background: var(--surface);
  }

  .finding-name {
    font-weight: 700;
    font-size: var(--step-lead);
    line-height: 1.2;
  }

  .finding-owasp {
    color: var(--muted);
  }

  .finding-cost {
    text-align: right;
    font: 800 1.125rem / 1 var(--display);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .note {
    margin: 32px 0 24px;
    font-size: var(--step-lead);
    max-width: 36ch;
  }

  .missing {
    padding-top: clamp(48px, 10vh, 120px);
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .missing h1 {
    font-size: var(--step-hero);
  }

  @media (max-width: 760px) {
    .totals {
      grid-template-columns: 1fr;
    }
    .finding {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .finding-cost {
      text-align: left;
    }
  }
</style>
