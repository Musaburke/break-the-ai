---
import Base from '../layouts/Base.astro';
import { RUNS_PER_DAY } from '../engine/budget';
---
<Base title="Full for today · Break the AI">
  <section class="full wrap" aria-labelledby="full-title">
    <span class="sticker">Back at midnight UTC</span>
    <h1 id="full-title">Full for today</h1>
    <p class="lead">All {RUNS_PER_DAY} of today's runs are taken. The game runs on a free daily AI allowance, and every run is reserved whole when it starts, so nobody gets cut off halfway.</p>
    <p class="note">Already started? Your progress is saved.</p>
    <a class="pill pill--big" href="/">Level select</a>
  </section>
</Base>

<style>
  .full {
    padding-block: clamp(32px, 8vh, 96px);
    display: grid;
    justify-items: start;
    gap: 28px;
  }

  .full h1 {
    font-size: var(--step-hero);
    line-height: 0.86;
  }

  .lead {
    font-size: var(--step-lead);
    line-height: 1.35;
    max-width: 38ch;
  }

  .note {
    color: var(--muted);
  }
</style>
